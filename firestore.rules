rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId && validScore();
      allow update: if request.auth != null && request.auth.uid == userId && validScore() && request.resource.data.score >= resource.data.score;
      allow delete: if false;
      function validScore() {
        let d=request.resource.data;
        return d.keys().hasOnly(['nickname','score','roundScores','updatedAt'])
          && d.keys().hasAll(['nickname','score','roundScores','updatedAt'])
          && d.nickname is string && d.nickname.size() >= 1 && d.nickname.size() <= 12
          && d.score is number && d.score >= 0 && d.score <= 500
          && d.roundScores is list && d.roundScores.size()==5
          && d.roundScores[0] is number && d.roundScores[0] >= 0 && d.roundScores[0] <= 100
          && d.roundScores[1] is number && d.roundScores[1] >= 0 && d.roundScores[1] <= 100
          && d.roundScores[2] is number && d.roundScores[2] >= 0 && d.roundScores[2] <= 100
          && d.roundScores[3] is number && d.roundScores[3] >= 0 && d.roundScores[3] <= 100
          && d.roundScores[4] is number && d.roundScores[4] >= 0 && d.roundScores[4] <= 100
          && d.updatedAt == request.time;
      }
    }
  }
}
